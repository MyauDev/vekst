# core/internal/dedup's own package doc before touching either table.
/core/migrations/00012_dedup.sql            @MyauDev/admin
/core/internal/db/query/dedup.sql           @MyauDev/admin

# The review queue and the P&L sections. 013 is the human decision that empties
# the queue and writes the memory L0 reads next month; 014 finishes a column
# migration 005 created and left NULL on every row.
/core/migrations/00013_review_decisions.sql   @MyauDev/admin
/core/migrations/00014_pnl_sections.sql       @MyauDev/admin


# -*- mode: Python -*-
# Vekst local development. Run `make dev` from the repo root, not tilt directly:
# the make target creates the k3d cluster with a pinned k3s version first.

load('ext://restart_process', 'docker_build_with_restart')

allow_k8s_contexts('k3d-vekst')

# --- manifests -------------------------------------------------------------
# The overlay carries a committed vekst-google-oidc Secret whose values are
# placeholders, so `kubectl kustomize` renders every overlay in CI without a
# real credential in the repository (add-identity design D6a).
#
# Real values live in a git-ignored google-oidc.secret.yaml beside it. Tilt
# refuses to deploy two objects with the same name, so the placeholder is
# filtered out and replaced rather than layered over -- filter_yaml returns
# (matching, rest), and only `rest` plus the real Secret is deployed.
#
# With no such file a developer still gets a working stack: everything runs and
# only the sign-in routes fail. core refuses to start on the placeholder value
# itself, so a half-configured stack fails with a clear configuration error
# rather than an opaque one at Google.
_manifests = kustomize('k8s/overlays/local')
_google_oidc_secret = 'k8s/overlays/local/google-oidc.secret.yaml'

if os.path.exists(_google_oidc_secret):
    _placeholder, _rest = filter_yaml(_manifests, kind='Secret', name='vekst-google-oidc')
    k8s_yaml(_rest)
    k8s_yaml(_google_oidc_secret)
    print('Vekst: Google sign-in configured from ' + _google_oidc_secret)
else:
    k8s_yaml(_manifests)
    print('Vekst: sign-in is NOT configured. Copy ' +
          'k8s/overlays/local/google-oidc.yaml to google-oidc.secret.yaml ' +
          'and fill in the three values.')

# --- core (Go) -------------------------------------------------------------
# live_update syncs sources and rebuilds inside the container. Without this a
# one-line change costs a full image build and rollout, and the team routes
# around the whole setup -- which is the failure mode design D5 warns about.
docker_build_with_restart(
    'vekst/core',
    context='..',
    dockerfile='docker/Dockerfile.core',
    target='dev',          # alpine: the restart wrapper needs a shell
    entrypoint=['/vekst-core'],
    build_args={'VERSION': 'dev', 'BUILT_AT': 'dev'},
    only=['go.mod', 'go.sum', 'core'],
    live_update=[
        sync('../core', '/src/core'),
        run('go build -o /vekst-core ./core/cmd/vekst-core', trigger=['../core']),
    ],
)

# --- classifier (Python) ---------------------------------------------------
# Pure Python: sync the sources and restart the gRPC server. No image rebuild.
docker_build_with_restart(
    'vekst/classifier',
    context='..',
    dockerfile='docker/Dockerfile.classifier',
    entrypoint=['python', '-m', 'vekst_classifier.server'],
    only=['classifier'],
    live_update=[
        # Dependency changes must rebuild the image, not sync into a stale venv.
        fall_back_on(['../classifier/pyproject.toml', '../classifier/uv.lock']),
        sync('../classifier/src', '/app/.venv/lib/python3.14/site-packages'),
        # Restart explicitly rather than relying on the extension to append it.
        # Verified by hand inside the container: writing this file makes entr(1)
        # replace the python process. The extension's own restart step was not
        # firing after a sync, so the file landed and the server kept serving
        # the previous code -- which looks exactly like "my edit did nothing".
        # One line here is much cheaper than that confusion.
        run('echo restart > /tmp/.restart-proc'),
    ],
)

# --- web (Vite) ------------------------------------------------------------
# Vite's HMR applies the change itself, so no restart and no reload.
docker_build(
    'vekst/web',
    context='..',
    dockerfile='docker/Dockerfile.web',
    target='dev',
    only=['web'],
    live_update=[
        fall_back_on(['../web/package.json', '../web/package-lock.json']),
        sync('../web/src', '/app/src'),
        sync('../web/index.html', '/app/index.html'),
    ],
)

# --- readability -----------------------------------------------------------
# migrate depends on postgres, and core depends on migrate having completed --
# design task 7.3b. core's own /readyz would eventually catch an unmigrated
# schema regardless, but the explicit dependency keeps the Tilt UI from
# showing a confusing failing-readiness core resource while the Job just
# hasn't run yet, and gives the same ordering a real Job-completion wait
# gives in a cluster where nothing is watching the dashboard.
k8s_resource('migrate',    labels=['data'], resource_deps=['postgres'])
k8s_resource('core',       labels=['app'],  port_forwards=['8080:8080'], resource_deps=['migrate'])
k8s_resource('classifier', labels=['app'],  port_forwards=['9090:9090'])
k8s_resource('web',        labels=['app'],  port_forwards=['5173:5173'])
k8s_resource('postgres',   labels=['data'])

print('Vekst: http://localhost:8081  (core /rpc, web /, auth /auth)')
# Plain localhost, not vekst.localhost: Google refuses a redirect URI on a
# subdomain of localhost, so no local redirect URI could be registered
# otherwise (add-identity design D6).

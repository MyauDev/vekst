# NOTE: generated code is deliberately NOT ignored.
# /core/gen, /web/src/gen and /classifier/gen are committed and drift-checked in CI.
# See design D4. Never add them here.

# Coverage output. Regenerated by CI for the SonarQube scan.
/coverage.out
/classifier/.coverage
/classifier/coverage.xml
/web/coverage/

# eval/: unpacked customer statements. Source data lives outside the repo
# (see eval/README.md) and its cache must never be committed.
eval/.statements/
eval/__pycache__/

# Chocolatey scratch, left in the working tree by `choco install`.
hoco/

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // vite/client types `import.meta.env`, which the dev-only token-sheet route
    // is gated on. An explicit `types` array means it is not picked up otherwise.
    "types": ["vitest/globals", "node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // `@/*` exists for one reason: the vendored bklit charts under
    // `src/components/charts` import `@/lib/utils`, and a shadcn-registry
    // component is copied in verbatim rather than edited. Our own code keeps
    // using relative imports -- see docs/ARCHITECTURE.md.
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
